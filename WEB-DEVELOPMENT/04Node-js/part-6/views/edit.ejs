<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body>
    <form method="post" action="/chats/<%=chat._id%>?_method=PUT">

    <h3>Edit your Chat:<%=chat._id%> </h3>
    <p>from</p> <input type="text" placeholder="<%=chat.from%>" name="from">
    <p>message:</p> <textarea name="msg" placeholder="<%=chat.msg%>"></textarea>
    <p>to</p> <input type="text" placeholder="<%=chat.to%>" name="to">
    <button> Edit</button>
</form>
</body>
</html>